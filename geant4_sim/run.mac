##-----------------------------------------##
/run/verbose 1
/event/verbose 0
/tracking/verbose 0
##-----------------------------------------##
/output/filename ./output.root
# Kill secondaries (i.e., SR photons)
/stack/killsecondaries 0
# Tagger's distance from the start of the far-bwd nate-chamber
#- v6.3
#/detector/dist_tag 5.0  m # Tagger-1
#/detector/dist_tag 20.2 m # Tagger-2
#/detector/dist_tag 24.7 m # Tagger-3
#/detector/dist_tag 29.2 m # Tagger-4
#/detector/dist_tag 31.3 m # Tagger-5
#- v6.3 modif_bwd
/detector/dist_tag  8.6 m # Tagger-1
/detector/dist_tag 16.6 m # Tagger-2
/detector/dist_tag 24.7 m # Tagger-3
/detector/dist_tag 29.2 m # Tagger-4
/detector/dist_tag 31.3 m # Tagger-5
# BWD ante-chamber height
/detector/bwd_achmbH 10 cm
# Rebuild geometry with the given parameters
/detector/ModifyGeometry


/run/initialize
##-----------------------------------------##
/run/beamOn 1000
##-----------------------------------------##
