##-----------------------------------------##
/run/verbose 1
/event/verbose 0
/tracking/verbose 0
##-----------------------------------------##
/output/filename ./output.root
# Kill secondaries (i.e., SR photons)
/stack/killsecondaries 0
# Tagger's distance from the start of the far-bwd ante-chamber
#- v6.3.1
/detector/dist_tag 5.0  m # Tagger-1
/detector/dist_tag 18.5 m # Tagger-2
#- v6.3
#/detector/dist_tag 5.0  m # Tagger-1
#/detector/dist_tag 20.2 m # Tagger-2
#/detector/dist_tag 24.7 m # Tagger-3
#/detector/dist_tag 29.2 m # Tagger-4
#/detector/dist_tag 31.3 m # Tagger-5
#- v6.3 modif_bwd
#/detector/dist_tag  8.6 m # Tagger-1
#/detector/dist_tag 16.6 m # Tagger-2
#/detector/dist_tag 24.7 m # Tagger-3
#/detector/dist_tag 29.2 m # Tagger-4
#/detector/dist_tag 31.3 m # Tagger-5
# BWD ante-chamber height
/detector/bwd_achmbH 6 cm
# BWD SR mask
#/detector/farBwdSrMaskDepth 10 mm
#/detector/farBwdSrMaskRelPos 12.5 m
# Rebuild geometry with the given parameters
/detector/ModifyGeometry

/run/initialize

/vis/open OGL
#/vis/open DAWNFILE # then: dawn g4_0000.prim; epstopdf g4_0000.eps
#/vis/open HepRepFile # then: heprapp G4Data0.heprep

/vis/drawVolume
/vis/viewer/set/viewpointThetaPhi -90. -89.9
#/vis/viewer/set/viewpointVector 0.001 1 0
#/vis/viewer/set/style cloud
#/vis/viewer/set/numberOfCloudPoints 10000
/vis/scene/add/trajectories
/vis/scene/endOfEventAction accumulate 100
/vis/scene/add/trajectories rich smooth
/vis/modeling/trajectories/create/drawByCharge
/vis/modeling/trajectories/drawByCharge-0/default/setDrawStepPts true
/vis/modeling/trajectories/drawByCharge-0/default/setStepPtsSize 2
/vis/modeling/trajectories/drawByCharge-0/default/setDrawAuxPts true
/vis/modeling/trajectories/drawByCharge-0/default/setAuxPtsSize 2
/vis/modeling/trajectories/drawByCharge-0/default/setTimeSliceInterval 0.001 ns

#- Axes, scale, etc.
/vis/scene/add/axes 0 0 0 2 m # Simple axes: x=red, y=green, z=blue.
/vis/scene/add/date    # Date stamp

##-----------------------------------------##
#- Visualize magnetic field
#/vis/set/volumeForField vac_IP
#/vis/set/volumeForField mag_D2EF1
#/vis/set/volumeForField mag_D2EF2
#/vis/set/volumeForField mag_D1EF
#/vis/set/volumeForField mag_Q1EF
#/vis/set/volumeForField mag_Q0EF
#/vis/set/volumeForField mag_MARCO
#/vis/set/volumeForField mag_Q3ER
#/vis/scene/add/magneticField 20 fullArrow #lightArrow
##-----------------------------------------##
#- Draws logical volume with additional components
#/vis/drawLogicalVolume LumiExitWindow_log
##-----------------------------------------##
#- Material scan
#/control/matScan/scan
##-----------------------------------------##

/vis/scene/list
/vis/drawTree
#- Built-in Commands:  https://geant4-userdoc.web.cern.ch/UsersGuides/ForApplicationDeveloper/html/Control/AllResources/Control/UIcommands/_.html
##-----------------------------------------##
/run/beamOn 1
##-----------------------------------------##
